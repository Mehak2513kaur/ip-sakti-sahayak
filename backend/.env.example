# IP-SAKTI Sahayak Environment Configuration
# Ministry of AYUSH, Government of India - SIH 2026

# AI / LLM Configuration (Set your official Gemini API key or leave blank for local grounded demo mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application Mode
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration (Defaults to SQLite for local zero-dependency run, supports PostgreSQL)
DATABASE_URL=sqlite:///./ip_sakti.db

# Security & CORS
SECRET_KEY=ayush_ip_sakti_secure_secret_token_2026
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Mode (auto: falls back to grounded statutory RAG when GEMINI_API_KEY is not set)
DEMO_MODE=auto
